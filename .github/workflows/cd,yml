name : Deploy to Production

on :
  push:
    branches:
      - main

cocnurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write        #read AWS auths

env:
  AWS_REGION: ${{ vars.AWS_REGION  || 'eu-north-1' }}
  ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY || 'agrirent' }}
  IMAGE_TAG: ${{ github.sha }}  
  TF_woRKING_DIR: terraform

jobs:
  check:
    name:${{ matrix.app-name }} checks
    runs-on: ubuntu-latest
    timeout-minutes: 20
    strategy:
      fail -fast : false
      matrix:
        include:
          - app-name: backend
            working-directory: backend
            lockfile: backend/package-lock.json
            lint-tools: eslint@^9 @eslint/js@^9 globals typescript-eslint
            lint-command: npx eslint src
            test-command: ""
            build-command: npm run build
          - app-name: frontend
            working-directory: frontend
            lockfile: frontend/package-lock.json
            lint-tools: eslint@^9 @eslint/js@^9 globals typescript-eslint eslint
            lint-command: |
              npx eslint src
              npx stylelint "src/**/*.css"
            test-command: npm test
            build-command: npm run build
    steps:
      - name: Checkout
        uses: actions/checkout@v7

       -name :setup node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: ${{ matrix.lockfile }}
      - name: Install dependencies
        run: npm ci
        working-directory: ${{ matrix.working-directory }}
      -name: dependencies audit
        run: npm audit   --audit-level=high
        working-directory: ${{ matrix.working-directory }} 

       -name: install lint tools
       if matrix.lint-tools != ''
       run: npm install --nosave ${{ matrix.lint-tools }}
       working-directory: ${{ matrix.working-directory }}

      - name: Lint
        if: matrix.lint-command != ''
        run: ${{ matrix.lint-command }}
        working-directory: ${{ matrix.working-directory }}

      - name: Tests
        if: matrix.test-command != ''
        run: ${{ matrix.test-command }}
        working-directory: ${{ matrix.working-directory }}

       -name: Build
        if: matrix.build-command != ''
        run: ${{ matrix.build-command }}
        working-directory: ${{ matrix.working-directory }}


iac_scan:
    name: IaC securiity check
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name : run tfsec
        uses: aquasecurity/tfsec-action@v1.0.0
        with:
        working-directory: terraform
        soft_fail: false

      
build_scan_push:
name: build, verify and deploy image
    runs-on: ubuntu-latest
    timeout-minutes: 39
    needs:
      - check
      - iac_scan
    outputs:
    image_url:${{ steps.build.outputs.image_url }}

    steps
    -name: Checkout
      uses: actions/checkout@v7

    -name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        role-to-assume: ${{ vars.AWS_ROLE_ARN }}
        aws-region: ${{ env.AWS_REGION }}

    -name: Login to Amazon ECR
      id: login-ecr
      uses: aws-actions/amazon-ecr-login@v2

      name set image-url
      id :image
      shell: bash
      run:
      registry=${{ steps.login-ecr.outputs.registry }}
      image_url="${registry}/${{ env.ECR_REPOSITORY }}:${{ env.IMAGE
      echo "image_url=${image_url}" >> $"GITHUB_ENV"
      echo "image_url=${image_url}" >> $"GITHUB_OUTPUT"

     -name build docker img
     if: hashFiles('Dockerfile') != ''
     docker build -t "$IMAGE_URI" -t "${{ steps.login-ecr.outputs.registry }}/${ECR_REPOSITORY}:latest" .

    -name run trivy container scan
     uses: aquasecurity/trivy-action@0.28.0
     with:
       scan-type: 'image'
       image-ref: ${{ env.image_url }}
       format: 'table'
       severity: 'CRITICAL'
       exit-code : '1'
       ignore-unfixed : 'true'
     -name push docker img
      run: |
          docker push "$IMAGE_URI"
          docker push "${{ steps.login-ecr.outputs.registry }}/${ECR_REPOSITORY}:latest"


deploy:
   name: deploy to production
   runs-on: ubuntu-latest 
   timeout-minutes: 30
   needds:
    -build_scan_push
   environment:
    name: production
    url: ${{ steps.deploy.outputs.web_url }}
   steps:
     -name: Checkout
      uses: actions/checkout@v7

     -name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        role-to-assume: ${{ vars.AWS_ROLE_TO_ASSUME }}
        aws-region: ${{ env.AWS_REGION }}

     -name: install ansible & dependencies
      run: |
       pipx install ansible --include-deps ansible
       ansible-galaxy collection install  -r ansible/requirements.yml
    -name: configure ssh for ansible
      shell : bash
      run: |
        mkdir -p ~/.ssh
        echo "${{ secrets.ANSIBLE_SSH_PRIVATE_KEY }}" > ~/.ssh/id_rsa
        chmod 600 ~/.ssh/id_rsa
      
     -name: config ansible vaultt pass 
     shell: bash
      
       run: |
          echo "${{ secrets.ANSIBLE_VAULT_PASSWORD }}" > ~/.ansible_vault_pass
          chmod 600 ~/.ansible_vault_pass

      -name: run ansible playbook
      working-directory: ansible
      env:
        ANSIBLE_HOST_KEY_CHECKING: false

      run: |
       ansible-playbook site.yml
