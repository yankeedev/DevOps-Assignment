# {{ ansible_managed }}
# Generated by Ansible. Do NOT edit by hand — regenerate with:
#   ansible-playbook site.yml --tags app
#
# This file is consumed by Docker Compose as the project-level .env.
# Sources:
#   - JWT secrets:    group_vars/all/vault.yml (encrypted)
#   - RDS password:   AWS Secrets Manager (fetched at deploy time)
#   - Image, host:    group_vars/all/vars.yml (non-secret)

# Image to run (tag from vars.yml, URI assembled in vars.yml)
APP_IMAGE={{ app_image }}

# Database connection — RDS, not a compose service.
# sslmode=require is mandatory: RDS rejects non-TLS connections by default,
# and the error ("no pg_hba.conf entry") looks like a networking issue but
# isn't. urlencode on user/password: RDS-generated passwords can contain
# @, :, / which would break URI parsing without encoding.
DATABASE_URL=postgresql://{{ rds_credentials.username | urlencode }}:{{ rds_credentials.password | urlencode }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}?sslmode=require

# JWT secrets (consumed by the app for access/refresh token signing)
JWT_ACCESS_SECRET={{ vault_jwt_access_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}