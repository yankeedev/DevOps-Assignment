# {{ ansible_managed }}
# Generated by Ansible. Do NOT edit by hand — regenerate with:
#   ansible-playbook site.yml --tags app
#
# This file is consumed by Docker Compose as the project-level .env.
# All values come from group_vars/all.yml (non-secret) and
# group_vars/vault.yml (encrypted secrets).

# Postgres superuser credentials (consumed by the `db` service)
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}

# Application database connection string (consumed by the `app` service)
# Built from the same postgres_* vars, so password rotation touches one place.
DATABASE_URL=postgresql://{{ postgres_user }}:{{ vault_postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}

# JWT signing secrets (consumed by the `app` service)
JWT_ACCESS_SECRET={{ vault_jwt_access_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}