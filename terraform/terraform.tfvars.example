

project_name = "my-application"
environment  = "dev"

aws_region = "REPLACE_WITH_AWS_REGION"
ami_id     = "ami-REPLACE_WITH_REGION_COMPATIBLE_UBUNTU_AMI"

instance_type = "t3.micro"
key_pair_name = "REPLACE_WITH_EXISTING_EC2_KEY_PAIR_NAME"

# Restrict SSH to your trusted public IP, e.g. "203.0.113.10/32".
ssh_allowed_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Set the image and ports to match your application.

root_volume_size = 20
