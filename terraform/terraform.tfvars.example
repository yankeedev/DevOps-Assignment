# Project configuration

project_name = "agrirent"
environment  = "dev"

# AWS configuration

aws_region = "REPLACE_WITH_AWS_REGION"

# Use an Ubuntu AMI compatible with your selected AWS region.

ami_id = "ami-REPLACE_WITH_REGION_COMPATIBLE_UBUNTU_AMI"

# EC2 configuration

instance_type         = "t3.micro"
bastion_instance_type = "t3.micro"

key_pair_name = "REPLACE_WITH_EXISTING_EC2_KEY_PAIR_NAME"

root_volume_size = 20

# SSH access to Bastion Host only.
# Use your trusted public IP followed by /32.

ssh_allowed_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Networking

vpc_cidr = "10.0.0.0/16"

public_subnet_a_cidr  = "10.0.1.0/24"
public_subnet_b_cidr  = "10.0.2.0/24"

private_subnet_a_cidr = "10.0.11.0/24"
private_subnet_b_cidr = "10.0.12.0/24"

# Application ports

app_port      = 5000
frontend_port = 4173

# Database

db_name              = "agrirent"
db_username          = "agrirent_admin"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

# Private container registry

ecr_repository_name = "agrirent"
